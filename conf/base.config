process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    // One image for both processes: the caller wrapper (bin/amrscan.py) needs
    // Python next to AMRFinderPlus. Built from environment/amrfinderplus.yml
    // with Seqera Containers; see docs/decisions/0005-containers.md.
    container = 'community.wave.seqera.io/library/ncbi-amrfinderplus_python:d86c65c0b0a702da'
    conda = "${projectDir}/environment/amrfinderplus.yml"

    // Retry only when the scheduler or the kernel killed the task (memory,
    // walltime); a caller or input error stops the run (decision 0007).
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'terminate' }
    maxRetries = 2

    cpus = 1
    memory = { 1.GB * task.attempt }
    time = { 30.min * task.attempt }

    withLabel: process_single {
        cpus = 1
        memory = { 1.GB * task.attempt }
        time = { 30.min * task.attempt }
    }
    withLabel: process_medium {
        cpus = { params.threads as int }
        memory = { 4.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
}
