process {
    executor = 'local'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
    // One image for both processes: the caller wrapper (bin/amrscan.py) needs
    // Python next to AMRFinderPlus. Built from environment/amrfinderplus.yml
    // with Seqera Containers; see docs/decisions/0005-containers.md.
    container = 'community.wave.seqera.io/library/ncbi-amrfinderplus_python:d86c65c0b0a702da'
    conda = "${projectDir}/environment/amrfinderplus.yml"
    withName: AMRFINDERPLUS {
        cpus = params.threads as int
        memory = 4.GB
        time = 2.h
    }
    withName: HARMONIZE_AMRFINDER {
        cpus = 1
        memory = 1.GB
        time = 30.min
    }
}
