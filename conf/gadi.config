// NCI Gadi (PBS Pro). Based on the nf-core/configs nci_gadi profile and meant
// for the Nextflow module installed on Gadi (`module load nextflow`), which
// accepts the project and storage directives used below.
// Compute nodes have no internet access: pull the image into the cache before
// submitting work (see docs/tutorial/gadi.md).
// The project charged comes from NCI_PROJECT (default qn73) and the file
// systems mounted from GADI_STORAGE (default scratch/<project>). Command-line
// params are not visible while this file is read, so they cannot set these.
// The image cache is NXF_SINGULARITY_CACHEDIR, else singularity/ in the
// launch directory.
def nciProject = System.getenv('NCI_PROJECT') ?: 'qn73'
def gadiStorage = System.getenv('GADI_STORAGE') ?: "scratch/${nciProject}"

// Gadi provides SingularityCE (module singularity), not an apptainer command.
singularity {
    enabled = true
    autoMounts = true
    cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${launchDir}/singularity"
}

executor {
    queueSize = 300
}

process {
    executor = 'pbspro'
    project = nciProject
    storage = gadiStorage
    module = 'singularity'
    cache = 'lenient'
    stageInMode = 'symlink'
    queue = { task.memory < 128.GB ? 'normalbw' : (task.memory <= 190.GB ? 'normal' : 'hugemembw') }
    // Harmonizing one report takes seconds; run it inside the head job rather
    // than as a separate PBS job per sample.
    withName: HARMONIZE_AMRFINDER {
        executor = 'local'
    }
}
