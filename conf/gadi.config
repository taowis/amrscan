// NCI Gadi (PBS Pro). Based on the nf-core/configs nci_gadi profile and meant
// for the Nextflow module installed on Gadi (`module load nextflow`), which
// accepts the project and storage directives used below.
// Compute nodes have no internet access: pull the image into the cache before
// submitting work (see docs/tutorial/gadi.md).
params {
    gadi_project = System.getenv('PROJECT')
    gadi_storage = "gdata/${params.gadi_project}+scratch/${params.gadi_project}"
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = "/scratch/${params.gadi_project}/${System.getenv('USER')}/nxf_apptainer_cache"
}

executor {
    queueSize = 300
}

process {
    executor = 'pbspro'
    project = "${params.gadi_project}"
    storage = "${params.gadi_storage}"
    module = 'singularity'
    cache = 'lenient'
    stageInMode = 'symlink'
    container = 'oras://community.wave.seqera.io/library/ncbi-amrfinderplus_python:03c3120e1c088608'
    queue = { task.memory < 128.GB ? 'normalbw' : (task.memory <= 190.GB ? 'normal' : 'hugemembw') }
}
