// NCI Gadi (PBS Pro). Based on the nf-core/configs nci_gadi profile and meant
// for the Nextflow module installed on Gadi (`module load nextflow`), which
// accepts the project and storage directives used below.
// Compute nodes have no internet access: pull the image into the cache before
// submitting work (see docs/tutorial/gadi.md).
// The project charged and the file systems mounted come from the environment,
// as in the nf-core nci_gadi profile: PROJECT, and optionally GADI_STORAGE.
// Command-line params are not visible while this file is read, so they
// cannot set these paths.
def gadi_project = System.getenv('PROJECT')
def gadi_storage = System.getenv('GADI_STORAGE') ?: "gdata/${gadi_project}+scratch/${gadi_project}"

// Gadi provides SingularityCE (module singularity), not an apptainer command.
singularity {
    enabled = true
    autoMounts = true
    cacheDir = "/scratch/${gadi_project}/${System.getenv('USER')}/nxf_singularity_cache"
}

executor {
    queueSize = 300
}

process {
    executor = 'pbspro'
    project = "${gadi_project}"
    storage = "${gadi_storage}"
    module = 'singularity'
    cache = 'lenient'
    stageInMode = 'symlink'
    queue = { task.memory < 128.GB ? 'normalbw' : (task.memory <= 190.GB ? 'normal' : 'hugemembw') }
    // Harmonizing one report takes seconds; run it inside the head job rather
    // than as a separate PBS job per sample.
    withName: HARMONIZE_AMRFINDER {
        executor = 'local'
    }
}
