// Small end-to-end run: one blaTEM-1 positive control against a pinned database.
// Fetch the database first: scripts/fetch_amrfinder_db.sh --engine docker
params {
    input = "${projectDir}/tests/fixtures/blaTEM-1_NG_050145.1.fna"
    amrfinder_db = "${projectDir}/db/amrfinderplus/2026-08-07.1"
    outdir = 'results/test'
    threads = 2
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
