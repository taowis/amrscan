// Settings shared by all nf-test cases. Run with a container profile, e.g.
//   nf-test test --profile docker
// Cases tagged "database" also need the pinned database:
//   scripts/fetch_amrfinder_db.sh --engine docker
params {
    outdir = 'results'
    threads = 2
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
