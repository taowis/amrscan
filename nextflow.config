manifest {
    name = 'taowis/amrscan'
    mainScript = 'main.nf'
    version = '2.0.0-dev'
    nextflowVersion = '>=25.04.6'
}

params {
    input = null
    outdir = 'results/v2'
    threads = 4
    amrfinder_db = null
    amrfinder_bin = 'amrfinder'
    amrfinder_organism = null
    amrfinder_plus = false
    amrfinder_identity = -1
    amrfinder_coverage = 0.5
    validate_only = false
    help = false
}

plugins {
    id 'nf-schema@2.5.1'
}

validation {
    help {
        enabled = true
        command = "nextflow run main.nf --input 'assemblies/*.fna' --amrfinder_db /path/to/versioned/db"
        afterText = 'See README.md and docs/result-schema.md. Legacy v1: legacy/workflow/AMRScan.nf'
    }
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled = true
        // linux/amd64 lets the image run on Apple silicon through emulation.
        docker.runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.container = 'oras://community.wave.seqera.io/library/ncbi-amrfinderplus_python:03c3120e1c088608'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = 'oras://community.wave.seqera.io/library/ncbi-amrfinderplus_python:03c3120e1c088608'
    }
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    gadi {
        includeConfig 'conf/gadi.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Execution reports for every run, as in nf-core pipelines.
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
    fields = 'task_id,hash,native_id,process,tag,status,exit,attempt,cpus,memory,time,realtime,%cpu,peak_rss,rchar,wchar,submit,start,complete,duration,queue'
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}
